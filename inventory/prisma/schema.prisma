generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Inventory {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  date      DateTime?
  rangeFrom DateTime?
  rangeTo   DateTime?
  paymentMethod String?
  cashPaid Float?
  posPayment Float?
  change Float?
  sales     InventorySale[]
  stocks    InventoryStock[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([type])
  @@index([date])
  @@index([rangeFrom, rangeTo])
}

model InventorySale {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  inventory      Inventory @relation(fields: [inventoryId], references: [id])
  inventoryId    String    @db.ObjectId
  sn             Int?
  customerSn     Int?
  customerName   String?
  productName    String
  carton         Boolean   @default(false)
  cartonQty      Int?
  packsPerCarton Int?
  pack           Boolean   @default(false)
  wholesale      Boolean   @default(false)
  pcsCount       Int?
  packQty        Int?
  pcsQty         Int?
  totalPcs       Int?
  costPrice      Float?
  packSalesPrice Float?
  pcsSalesPrice  Float?
  price          Float?
  total          Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model InventoryStock {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  inventory      Inventory @relation(fields: [inventoryId], references: [id])
  inventoryId    String    @db.ObjectId
  sn             Int?
  productName    String
  carton         Boolean   @default(false)
  cartonQty      Int?
  packsPerCarton Int?
  pack           Boolean   @default(false)
  pcsCount       Int?
  packQty        Int?
  pcsQty         Int?
  totalPcs       Int?
  costPrice      Float?
  packSalesPrice Float?
  pcsSalesPrice  Float?
  total          Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}